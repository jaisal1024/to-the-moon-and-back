{
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "build": "pnpm run generate && pnpm run migrate:if-configured && next build",
    "dev": "concurrently \"pnpm run dev:next\" \"pnpm run dev:generate\"",
    "dev:next": "next dev -p 3333",
    "dev-local": "docker compose up -d --wait db && pnpm run migrate && pnpm run dev",
    "dev-local:down": "docker compose down",
    "dev:generate": "pnpm run generate --watch",
    "format": "prettier --write . --ignore-path .gitignore",
    "generate": "graphql-codegen --config codegen.ts",
    "graphql-deploy": "sanity graphql deploy",
    "graphql-deploy:prod": "sanity graphql deploy --dataset=production --force",
    "lint": "eslint .",
    "lint:fix": "pnpm run format && pnpm run lint --fix",
    "ngrok-start": "ngrok http 3000",
    "start": "next start",
    "type-check": "node ./node_modules/typescript-compiler/bin/tsc --noEmit",
    "revalidate": "tsx scripts/revalidate.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "knip:strict": "knip --strict",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run lint && pnpm run type-check && pnpm run test && pnpm run knip",
    "deps:audit": "npm-check-updates --target latest --reject typescript",
    "prepare": "husky && (git config --worktree --unset core.hooksPath 2>/dev/null || true)",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "create-admin": "payload run scripts/create-admin.ts",
    "migrate:create": "payload migrate:create",
    "migrate:if-configured": "if [ -n \"$DATABASE_URL\" ]; then payload migrate; else echo 'DATABASE_URL not set, skipping payload migrate'; fi"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@sanity/code-input": "^7.3.9",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/ui": "^4.3.0",
    "@sanity/vision": "^6.18.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "graphql": "^16.8.1",
    "next": "16.4.0",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "sanity": "^6.18.0",
    "styled-components": "^6.5.3",
    "suspend-react": "^0.1.3",
    "zod": "^4.6.5",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "payload": "3.90.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/client-preset": "^6.2.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@next/bundle-analyzer": "16.4.0",
    "@next/env": "16.4.0",
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-compiler": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "type": "module"
}
