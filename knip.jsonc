{
  "$schema": "https://unpkg.com/knip@^6/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/components/**/*.{ts,tsx,js,jsx}",
    "src/hooks/**/*.{ts,tsx,js,jsx}",
    "scripts/**/*.{ts,tsx,js,jsx}",
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx,css}", "e2e/**/*.{ts,tsx,js,jsx}", "next.config.*", "postcss.config.*"],
  "ignore": [
    "src/env.schema.ts",
    "src/sanity/components/IFramePreviewView.tsx",
    "src/sanity/preview.ts",
    "src/utils/helpers.ts",
    "src/utils/types.ts",
  ],
  "ignoreDependencies": ["@sanity/preview-url-secret", "@sanity/ui", "zod", "suspend-react"],
}
