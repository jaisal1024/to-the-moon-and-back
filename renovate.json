{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Payload pins supported Next.js versions, so upgrade them together.",
      "groupName": "next and payload",
      "matchPackageNames": ["next", "eslint-config-next", "payload", "@payloadcms/**"]
    }
  ]
}
