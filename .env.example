# Local Docker Postgres started by `bun run dev-local`; on Vercel the Neon integration injects it.
DATABASE_URL=postgres://postgres:postgres@localhost:54320/to_the_moon
# Signs Payload admin sessions. Any long random string locally; a real secret in Vercel.
PAYLOAD_SECRET=local-dev-payload-secret-change-me

# Vercel Blob. Locally these point at the Docker emulator from `bun run dev-local`;
# on Vercel only BLOB_READ_WRITE_TOKEN is set (by the Blob store) and the URLs default to Vercel's.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_emulator_localdevonly
VERCEL_BLOB_API_URL=http://localhost:3100/api/blob
NEXT_PUBLIC_VERCEL_BLOB_API_URL=http://localhost:3100/api/blob
STORAGE_VERCEL_BLOB_BASE_URL=http://localhost:3100

# Authenticates POST /api/revalidateRoute (bun run revalidate <slug>). Any value locally.
REVALIDATE_SECRET=local-dev-revalidate-secret
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-KL7CLHPFFB
